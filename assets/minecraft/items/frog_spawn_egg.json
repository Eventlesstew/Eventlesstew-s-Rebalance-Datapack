{
    "model": {
        "type": "select",
        "property": "custom_model_data",
        "cases": [
            {
                "when": "minecraft:cold",
                "model": {
                    "type": "model",
                    "model": "event:item/frog_bucket/cold"
                }
            },
            {
                "when": "minecraft:warm",
                "model": {
                    "type": "model",
                    "model": "event:item/frog_bucket/warm"
                }
            }
        ],
        "fallback": {
            "type": "model",
            "model": "event:item/frog_bucket/temperate"
        }
    }
}