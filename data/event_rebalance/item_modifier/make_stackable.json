{
    "type": "filtered",
    "item_filter": {
        "items": "#event_rebalance:change_to_stackable"
    },
    "on_pass": {
        "type": "sequence",
        "functions": [
            "event_rebalance:modified",
            {
                "type": "set_components",
                "components": {
                    "max_stack_size": 64
                }
            }
        ]
    }
}