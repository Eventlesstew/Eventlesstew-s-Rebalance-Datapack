execute if predicate event_rebalance:item/hammer/enchantment/squeeze run function event_rebalance:items/hammer/enchantments/squeeze/sound with storage balance.hammer_attack
execute if predicate event_rebalance:item/hammer/enchantment/spinner run playsound enchant.spinner ambient @a ~ ~ ~ 1 1.1
$execute if predicate event_rebalance:item/hammer/enchantment/sharpness run execute at @n[type=marker,tag=balance.hammer_area] run execute as @e[type=#mobs,distance=..$(sweep_radius),tag=!balance.hammer_attacker] at @s run playsound enchant.power.melee ambient @a
$execute if predicate event_rebalance:item/hammer/enchantment/smite run execute at @n[type=marker,tag=balance.hammer_area] run execute as @e[type=#mobs,type=#minecraft:sensitive_to_smite,distance=..$(sweep_radius),tag=!balance.hammer_attacker] at @s run playsound enchant.smite ambient @a
$execute at @n[type=marker,tag=balance.hammer_area] run execute as @e[type=#event_rebalance:mobs,type=!#minecraft:sensitive_to_smite,distance=..$(sweep_radius),tag=!balance.hammer_attacker] run damage @s $(enchanted_damage) player_attack by @n[tag=balance.hammer_attacker]
$execute at @n[type=marker,tag=balance.hammer_area] run execute as @e[type=#event_rebalance:mobs,type=#minecraft:sensitive_to_smite,distance=..$(sweep_radius),tag=!balance.hammer_attacker] run damage @s $(enchanted_undead_damage) player_attack by @n[tag=balance.hammer_attacker]